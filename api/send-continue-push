import { createClient } from '@supabase/supabase-js';
import webpush from 'web-push';

webpush.setVapidDetails(
  process.env.VAPID_SUBJECT,
  process.env.VAPID_PUBLIC_KEY,
  process.env.VAPID_PRIVATE_KEY
);

const supabase = createClient(
  process.env.SUPABASE_URL,
  process.env.SUPABASE_SERVICE_ROLE_KEY
);

export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  try {
    // Supabase Database Webhook이 보내주는 기본 데이터 구조
    const { type, table, record, old_record } = req.body;

    if (table !== 'matches' || type !== 'UPDATE') {
      return res.status(200).json({ message: 'Ignored event' });
    }

    let actingUserId = null;

    // user1_continue가 false -> true로 바뀐 순간 포착
    if (record.user1_continue === true && old_record.user1_continue !== true) {
      actingUserId = record.user1_id;
    }
    // 또는 user2_continue가 false -> true로 바뀐 순간 포착
    else if (record.user2_continue === true && old_record.user2_continue !== true) {
      actingUserId = record.user2_id;
    }

    // 둘 다 아니라면 알림 보낼 필요 없음
    if (!actingUserId) {
      return res.status(200).json({ message: 'No continue action detected' });
    }

    // 상대방(파트너) ID 식별
    const partnerId = (record.user1_id === actingUserId) ? record.user2_id : record.user1_id;
    if (!partnerId) return res.status(400).json({ error: 'Partner not found' });

    // 파트너의 푸시 토큰 조회
    const { data: partner, error: partnerError } = await supabase
      .from('users')
      .select('push_token, has_enabled_push')
      .eq('id', partnerId)
      .single();

    if (partnerError || !partner || !partner.push_token || partner.has_enabled_push === false) {
      return res.status(200).json({ message: 'Partner push disabled or missing' });
    }

    const pushSubscription = typeof partner.push_token === 'string' 
      ? JSON.parse(partner.push_token) 
      : partner.push_token;

    // 영문 푸시 알림 전송
    const payload = JSON.stringify({
      title: '👀 Your buddy pressed Continue!',
      body: 'Your partner wants to keep chatting tomorrow. Check out the app!',
      url: '/'
    });

    await webpush.sendNotification(pushSubscription, payload);

    return res.status(200).json({ success: true, message: 'Continue push sent via DB trigger' });

  } catch (error) {
    console.error('Error in DB webhook push:', error);
    return res.status(500).json({ error: 'Internal server error' });
  }
}
